# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/shasha_ai"

# --- Auth ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Signup defaults ---
SIGNUP_BONUS_CREDITS="100"

# --- Rate limiting (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Payments ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Object storage (e.g. S3-compatible / Cloudflare R2) ---
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_REGION=""
STORAGE_PUBLIC_CDN_URL=""

# --- AI providers ---
# Add one line per provider you enable in the admin panel; the `secretRef`
# column on AiProvider should match the env var name you use here, e.g.:
# STABILITY_API_KEY=""
# ELEVENLABS_API_KEY=""
# OPENAI_API_KEY=""
